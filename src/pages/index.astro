---
import Base from "../layouts/Base.astro";
import JwtInspector from "../components/JwtInspector.astro";
import ToolCard from "../components/ToolCard.astro";
import { tools } from "../data/tools";
import { SITE, TAGLINE } from "../data/site";
---

<Base
  title={`${SITE.name} — ${TAGLINE}`}
  description="Six client-side security utilities. Decode a JWT, scrub a HAR, grade your headers. Nothing leaves the browser."
  facts
>
  <div class="wrap">
    <section class="hero">
      <div class="hero-copy">
        <div class="eyebrow"><i></i>six tools live · v1.0</div>
        <h1>Security tools<br />that run in your tab.</h1>
        <p class="sub">
          Six utilities for people who read headers. No uploads, no accounts, no requests after load.
        </p>
        <div class="ctas">
          <a class="btn btn-p" href="#tools">Open the toolkit</a>
          <a class="btn btn-g" href="#notes">Read field notes</a>
        </div>
        <div class="hero-note">
          <span>parsed in-browser</span>
          <span>·</span>
          <span>0 trackers</span>
          <span>·</span>
          <span>open source</span>
        </div>
      </div>

      <div class="hero-side">
        <JwtInspector compact />
      </div>
    </section>

    <section class="sec" id="tools">
      <h2>The toolkit</h2>
      <p class="h2meta">06 utilities · 0 backend · every parse happens in the tab</p>

      <div class="tools">
        {tools.map((tool) => <ToolCard tool={tool} />)}
      </div>
    </section>

    <section class="sec" id="notes">
      <h2>Field notes</h2>
      <p class="h2meta">failure modes these tools exist to catch</p>

      <div class="log">
        <div class="row">
          <div class="meta">2026 · har<br />query strings &amp; bodies</div>
          <div>
            <h3>Cookies are the easy part</h3>
            <p>
              Headers are the loud layer — everyone scrubs <code>Cookie</code> and <code>Authorization</code>.
              Query strings, <code>redirectURL</code> chains, and form bodies carry the same session material,
              and a HAR exporter records all of them verbatim.
            </p>
          </div>
          <div class="amt">har sanitizer<span>tool</span></div>
        </div>
        <div class="row">
          <div class="meta">2026 · jwt<br />decode vs verify</div>
          <div>
            <h3>A signature check can exist and never run</h3>
            <p>
              Most libraries decode a token to read claims without touching the signature. That is fine for a
              UI and fatal on a server: if the request handler only calls <code>decode</code>, the token is
              attacker-authored data wearing a valid shape.
            </p>
          </div>
          <div class="amt">jwt inspector<span>tool</span></div>
        </div>
        <div class="row">
          <div class="meta">2026 · csp<br />directive precedence</div>
          <div>
            <h3>A header grade is not a risk score</h3>
            <p>
              Nine checks can pass while one <code>script-src</code> with <code>'unsafe-inline'</code> makes the
              whole policy decorative. What matters is which directive wins, not how many headers were sent.
            </p>
          </div>
          <div class="amt">csp evaluator<span>tool</span></div>
        </div>
      </div>
    </section>
  </div>
</Base>
